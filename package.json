{
  "name": "hodor",
  "version": "0.3.4",
  "description": "AI-powered code review agent that finds bugs, security issues, and logic errors in pull requests",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "bin": {
    "hodor": "dist/cli.js"
  },
  "scripts": {
    "build": "tsup",
    "dev": "tsx src/cli.ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "lint": "tsc --noEmit"
  },
  "files": [
    "dist",
    "templates"
  ],
  "keywords": [
    "ai",
    "code-review",
    "github",
    "gitlab",
    "pr",
    "automation",
    "agent",
    "hodor"
  ],
  "author": "Karan",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/mr-karan/hodor"
  },
  "engines": {
    "node": ">=22"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.39.0",
    "@earendil-works/pi-ai": "^0.83.0",
    "@earendil-works/pi-coding-agent": "^0.83.0",
    "@opentelemetry/api": "^1.9.1",
    "@opentelemetry/auto-instrumentations-node": "^0.81.0",
    "@opentelemetry/exporter-trace-otlp-grpc": "^0.223.0",
    "@opentelemetry/instrumentation": "^0.223.0",
    "@opentelemetry/resources": "^2.12.0",
    "@opentelemetry/sdk-node": "^0.223.0",
    "@opentelemetry/semantic-conventions": "^1.43.0",
    "@sinclair/typebox": "^0.34.48",
    "chalk": "^5.4.0",
    "commander": "^13.1.0",
    "dotenv": "^16.4.0",
    "prom-client": "^15.1.3",
    "snappyjs": "^0.7.0"
  },
  "devDependencies": {
    "@opentelemetry/sdk-trace-base": "^2.12.0",
    "@types/node": "^22.0.0",
    "@types/snappyjs": "^0.7.1",
    "tsup": "^8.0.0",
    "tsx": "^4.0.0",
    "typescript": "^5.7.0",
    "vitest": "^3.0.0"
  }
}
